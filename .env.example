NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_KEYCLOAK_URL=your-keycloak-url
NEXT_PUBLIC_KEYCLOAK_REALM=your-realm
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=your-client-id-local
KEYCLOAK_ISSUER_URL=your-issuer-url
KEYCLOAK_JWKS_URI=your-jwks-uri
KEYCLOAK_AUDIENCE=backend-api
SSO_ALLOWED_ROLES=allowed roles
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
REDIS_PASSWORD=your-password-123
REDIS_URL=redis://:your-password-123@redis:6379
WHATSAPP_CHROMIUM_PATH=/snap/bin/chromium
DISABLE_SSO=true
NEXT_PUBLIC_DISABLE_SSO=true
WHATSAPP_ORCHESTRATOR_ENABLED=true
WHATSAPP_ORCHESTRATOR_BASE_URL=http://orchestrator:3099
WHATSAPP_ORCHESTRATOR_TOKEN=change-this-internal-token
SCHEDULER_SECRET=change-this-scheduled-blast-cron-token
WHATSAPP_ORCHESTRATOR_MAX_CONTAINERS=4
WHATSAPP_ORCHESTRATOR_START_COOLDOWN_MS=10000
WHATSAPP_ORCHESTRATOR_RESTART_COOLDOWN_MS=20000
WHATSAPP_BOT_IMAGE=iom4-bot:latest
WHATSAPP_BOT_NETWORK=if3250_k02_g10_iom4_default
WHATSAPP_BOT_MEMORY_LIMIT=768m
WHATSAPP_BOT_CPUS=1
# Optional: improves Instagram carousel/media scraping. Use a low-risk account session.
INSTAGRAM_COOKIE=sessionid=your-sessionid; csrftoken=your-csrftoken
# Optional: lets yt-dlp download X/Twitter media that requires an authenticated session.
X_YT_DLP_COOKIES_PATH=/app/secrets/x-cookies.txt

# local pg ct
POSTGRES_DB=iom4
POSTGRES_USER=iom4
POSTGRES_PASSWORD=iom4_password
DATABASE_URL=postgresql://iom4:iom4_password@localhost:5432/iom4
DATABASE_URL_DOCKER=postgresql://iom4:iom4_password@postgres:5432/iom4

# local miniio ct
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
S3_ENDPOINT=http://localhost:9000
S3_ENDPOINT_DOCKER=http://minio:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin123
S3_BUCKET=content-assets
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
