    "keycloak-js": "^26.2.3",
    "next": "16.2.4",
    "papaparse": "^5.5.2",
    "playwright-core": "1.59.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "react": "19.2.3",
